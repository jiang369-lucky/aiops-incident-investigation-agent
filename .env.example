# OpenAI-compatible Chat Completions endpoint. The offline heuristic mode needs no API key.
AGENT_MODEL_MODE=heuristic
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_API_KEY=
AGENT_MODEL=qwen-plus

# Paths are resolved from the project root when omitted.
AGENT_DATABASE_PATH=data/processed/openstack_logs.db
AGENT_SKILLS_PATH=skills
AGENT_RUNBOOKS_PATH=knowledge/runbooks
